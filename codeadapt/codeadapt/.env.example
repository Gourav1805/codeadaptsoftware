# ==============================================================================
# CodeAdapt Configuration Template
# Copy this file to .env or set environment variables in your environment.
# Note: Do NOT commit production secret values to version control.
# ==============================================================================

# Compiler Configuration (MinGW-w64 GCC 16.1.0 UCRT 64-bit recommended)
# Path to g++ executable. If left empty, CodeAdapt searches C:\mingw64\bin\g++.exe and PATH.
SI_GXX=C:\mingw64\bin\g++.exe

# Compiler Flags & C++ Standards
SI_CXX_STD=c++17
SI_OPT=-O1

# Sandbox Limits (Enforced via Windows Job Objects)
SI_TIMEOUT_S=3.0
SI_MEMORY_MB=256
SI_COMPILE_TIMEOUT_S=20
SI_MAX_CONCURRENT=4

# Database Configuration
# Relative to repository root or absolute path
SI_DB=backend/evidence.db

# Dynamic UB Probing (1 to enable -D_GLIBCXX_ASSERTIONS secondary probe, 0 to disable)
SI_UB_PROBE=1

# Security & Session Settings
# Set to 1 in production environments with HTTPS; set to 0 for local HTTP development.
SI_COOKIE_SECURE=0
